{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "kind", "value": "game" }],
      "destination": "/games/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "kind", "value": "app" }],
      "destination": "/apps/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/covers/parked.png",
      "destination": "/covers/parked.svg"
    }
  ]
}
